{
  "package_id": "com.hindsightwise.headsuppulse",
  "edition": "202601",
  "name": "HeadsUp Pulse",
  "version": "0.1.0",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "supported_languages": [
    "en"
  ],
  "permissions": [
    {
      "name": "g2-microphone",
      "desc": "Captures push-to-talk voice replies from the Even G2 beamforming microphone for user-approved Telegram replies and paper hedge drafts."
    },
    {
      "name": "network",
      "desc": "Reads live Hyperliquid and Polymarket market telemetry and dispatches user-approved Telegram replies through the whitelisted local proxy.",
      "whitelist": [
        "https://api.hyperliquid-testnet.xyz",
        "https://api.hyperliquid.xyz",
        "https://gamma-api.polymarket.com",
        "https://api.telegram.org"
      ]
    }
  ],
  "description": "Glanceable Even G2 (576x288) Telegram priority digest and Hyperliquid + Polymarket 1-tap paper/testnet read-and-write companion.",
  "sdkPackage": "@evenrealities/even_hub_sdk",
  "sdkVersion": "0.0.16",
  "display": {
    "width": 576,
    "height": 288,
    "colorMode": "monochrome-green",
    "brightnessMin": 0,
    "brightnessMax": 4,
    "maxVisibleLines": 4,
    "maxCharsPerLine": 44,
    "singleActiveCard": true
  },
  "backendProxy": {
    "host": "127.0.0.1",
    "defaultPort": 8787,
    "healthPath": "/api/health",
    "endpoints": [
      "/api/health",
      "/api/pulse",
      "/api/action/confirm",
      "/api/telegram/reply-draft",
      "/api/stt/transcribe"
    ]
  },
  "networkWhitelist": [
    "https://api.hyperliquid-testnet.xyz",
    "https://api.hyperliquid.xyz",
    "https://gamma-api.polymarket.com",
    "https://api.telegram.org"
  ],
  "corsAllowedOrigins": [
    "http://127.0.0.1",
    "http://localhost",
    "https://hub.evenrealities.com",
    "https://hindsightwise.github.io"
  ],
  "tracks": [
    {
      "id": 4799,
      "name": "Crypto & DeFi",
      "qualifiedIntegrations": [
        "Hyperliquid",
        "Polymarket"
      ]
    },
    {
      "id": 4795,
      "name": "Messaging & News",
      "qualifiedIntegrations": [
        "Telegram"
      ],
      "specialPrize": "Best Telegram Integration"
    }
  ],
  "safetyPolicy": {
    "paperTradingOnly": true,
    "testnetOrReadOnly": true,
    "custodyOfUserFunds": false,
    "financialAdvice": false,
    "clientEmbeddedSecrets": false
  }
}
